<table style="width: 100%; padding: 45px 35px; box-sizing: border-box; background-color: teal; color: wheat">
    <tr>
        <td style="font-size: 20px; text-align: center;">
            Hi, {{name}}, welcome to out platform!
        </td>
    </tr>
    <tr>
        <td style="text-align: center;">
            <p style="margin: 17px 0 0; color: firebrick">
                Hello, {{name}}, for activate your account click on activate button
            </p>
        </td>
    </tr>
    <tr>
        <td style="text-align: center;">
            <a href="{{url}}">
                <button style="padding: 5px 10px; font-size: 18px; background-color: wheat; color: teal">
                    ACTIVATE
                </button>
            </a>
        </td>
    </tr>
</table>